# Core Cryptographic Secrets
SECRET_KEY=mahagov-pulse-enterprise-super-secret-key-2026-mumbai
ADV_MASTER_SECRET=MAHA_GOV_ADV_SOVEREIGN_KEY_2026_FIPS140_3

# ------------------------------------------------------------------------------
# Real Aadhaar e-KYC Gateway (UIDAI Real SMS OTP + Real Citizen Demographic Data)
# ------------------------------------------------------------------------------
# Supported Providers: "sandbox" (Sandbox.co.in) | "surepass" (Surepass.io) | "mock"
AADHAAR_GATEWAY_PROVIDER=sandbox

# 1. If using Sandbox.co.in (https://sandbox.co.in):
# Get your API key and secret from https://sandbox.co.in dashboard:
AADHAAR_API_KEY=
AADHAAR_API_SECRET=
AADHAAR_BASE_URL=https://api.sandbox.co.in

# 2. If using Surepass.io (https://surepass.io):
# AADHAAR_GATEWAY_PROVIDER=surepass
# AADHAAR_API_KEY=your_surepass_bearer_token
# AADHAAR_BASE_URL=https://kyc-api.surepass.io

# ------------------------------------------------------------------------------
# Real MeitY DigiLocker / MeriPehchaan (National SSO) Credentials
# ------------------------------------------------------------------------------
